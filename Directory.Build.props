<Project>

  <!--
    Settings shared by every project in the Dvopan repository.
    Project-specific settings live in the individual .csproj files.
  -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <Deterministic>true</Deterministic>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Dvopan</Product>
    <Company>Dmytro Soyenko</Company>
    <Copyright>Copyright (c) 2026 Dmytro Soyenko and Dvopan contributors</Copyright>
    <Authors>Dmytro Soyenko and Dvopan contributors</Authors>
    <Version>0.1.0</Version>
    <RepositoryUrl>https://github.com/Saixus/Dvopan</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

</Project>
